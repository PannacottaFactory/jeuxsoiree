---
/**
 * Gabarit commun à toutes les pages : <head> optimisé, thème, en-tête et pied de page.
 * Aucune balise <script> bloquante : les pages SEO sont 100 % HTML + CSS.
 */
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '~/styles/global.css';
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import type { GameSlug } from '~/games/meta';
import type { JsonLd } from '~/lib/jsonld';
import { href } from '~/lib/url';
import { getValidatedContent } from '~/data/validate';

interface Props {
  title: string;
  description: string;
  path: string;
  game?: GameSlug;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: JsonLd[];
  /** Écran de jeu plein écran : ni en-tête ni pied de page du site. */
  bare?: boolean;
}

const { game, bare = false, ...seo } = Astro.props;

// Fait échouer le build si un contenu de jeu est invalide (exécuté au build uniquement).
getValidatedContent();

const themeColor = '#0d0a17';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <Seo {...seo} />
  </head>
  <body data-game={game}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {!bare && <Header current={game} />}
    <main id="contenu">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
