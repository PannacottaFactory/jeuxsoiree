---
/**
 * Vitrine du design system (noindex, hors sitemap) : palette Néon et composants, par jeu.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import GameIcon from '~/components/GameIcon.astro';
import { GAME_LIST } from '~/games/meta';
---

<BaseLayout title="Design system | Jeux de soirée" description="Palette et composants du design system." path="/design/" noindex>
  <section class="container section">
    <h1>Design system</h1>
    <p class="muted prose">
      Palette « Néon » : jaune soleil pour Rigolol, violet-magenta pour Mimos, cyan électrique pour Takotac. Chaque écran
      prend la couleur de son jeu via l’attribut <code>data-game</code>. Contrastes conformes WCAG AA.
    </p>
    <div class="grid grid--3">
      {
        GAME_LIST.map((g) => (
          <div class="swatch glass" data-game={g.slug}>
            <GameIcon game={g.slug} size={72} uid="design" />
            <p class="eyebrow">{g.tagline}</p>
            <h2 class="swatch__title gradient-text">{g.name}</h2>
            <div class="swatch__bar" aria-hidden="true" />
            <div class="swatch__actions">
              <Button href="#">Jouer</Button>
              <Button href="#" variant="ghost">
                Règles
              </Button>
            </div>
            <div class="swatch__timer" aria-hidden="true">
              <span>0:07</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .swatch {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }
  .swatch .eyebrow {
    margin: 0;
  }
  .swatch__title {
    font-size: var(--fs-2xl);
    margin: 0;
  }
  .swatch__bar {
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--accent-gradient);
    box-shadow: 0 0 20px var(--accent-glow);
  }
  .swatch__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .swatch__timer {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: conic-gradient(var(--accent) 0 70%, var(--surface-strong) 70% 100%);
  }
  .swatch__timer span {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--bg);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
  }
</style>
