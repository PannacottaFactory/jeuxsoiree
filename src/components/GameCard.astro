---
/**
 * Carte d'un jeu (page d'accueil) : toute la carte est cliquable, le titre porte le lien (accessibilité).
 */
import GameIcon from './GameIcon.astro';
import type { GameMeta } from '~/games/meta';
import { href } from '~/lib/url';

interface Props {
  game: GameMeta;
  index?: number;
}
const { game, index = 0 } = Astro.props;
---

<article class="game-card glass rise" data-game={game.slug} style={`--i: ${index}`}>
  <div class="game-card__art">
    <GameIcon game={game.slug} size={96} uid="card" />
  </div>
  <div class="game-card__body">
    <p class="game-card__tagline">{game.tagline}</p>
    <h3 class="game-card__title">
      <a href={href(`/${game.slug}/`)} class="game-card__link">{game.name}</a>
    </h3>
    <p class="game-card__pitch muted">{game.pitch}</p>
    <ul class="game-card__facts" aria-label="En bref">
      <li>{game.players.label}</li>
      <li>{game.duration}</li>
    </ul>
    <span class="game-card__cta" aria-hidden="true">Découvrir {game.name} →</span>
  </div>
</article>

<style>
  .game-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-5);
    overflow: hidden;
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2);
  }
  .game-card::before {
    content: '';
    position: absolute;
    inset: -40% -30% auto auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow), transparent 65%);
    opacity: 0.55;
    pointer-events: none;
  }
  .game-card:hover,
  .game-card:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .game-card__art {
    position: relative;
  }
  .game-card__tagline {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .game-card__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-2);
  }
  .game-card__link {
    color: var(--text);
    text-decoration: none;
  }
  /* Le lien du titre couvre toute la carte */
  .game-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .game-card__link:focus-visible {
    outline: none;
  }
  .game-card:has(.game-card__link:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .game-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
  }
  .game-card__facts li {
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .game-card__cta {
    font-family: var(--font-display);
    font-weight: 750;
    color: var(--accent);
  }
</style>
