---
/**
 * Logo « Jeux de soirée » : une bulle de discussion aux trois points, un par jeu (Rigolol, Mimos, Takotac).
 */
interface Props {
  size?: number;
  withText?: boolean;
  /** Identifiant unique du dégradé SVG (le logo apparaît plusieurs fois par page). */
  id?: string;
}
const { size = 36, withText = true, id = "logo" } = Astro.props;
const gradId = `${id}-grad`;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color: var(--rigolol-1)" />
        <stop offset="0.5" style="stop-color: var(--mimos-1)" />
        <stop offset="1" style="stop-color: var(--takotac-1)" />
      </linearGradient>
    </defs>
    <path
      d="M24 4c11.6 0 20 7.6 20 17.5S35.6 39 24 39c-2.2 0-4.3-.3-6.3-.8L9 43.5c-1 .6-2.2-.3-1.9-1.4l2-7.6C6 31.4 4 26.8 4 21.5 4 11.6 12.4 4 24 4Z"
      fill={`url(#${gradId})`}></path>
    <circle cx="15" cy="21.5" r="3.4" fill="#140f1f"></circle>
    <circle cx="24" cy="21.5" r="3.4" fill="#140f1f"></circle>
    <circle cx="33" cy="21.5" r="3.4" fill="#140f1f"></circle>
  </svg>
  {withText && <span class="logo__text">Jeux de soirée</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .logo__text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }
</style>
